# ═══════════════════════════════════════
# LIS — Living Intelligent System
# Environment Configuration
# ═══════════════════════════════════════

# At least one LLM provider is required. Free options: Groq, Gemini, Cerebras
# LIS automatically falls back through providers in this order:
# Anthropic → Groq → Gemini → Cerebras → OpenRouter → Ollama

# --- LLM Providers ---
ANTHROPIC_API_KEY=your-anthropic-key-here
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
CEREBRAS_API_KEY=your-cerebras-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
NVIDIA_API_KEY=your-nvidia-nemo-key-here
# Ollama: no key needed, just install and run locally


# --- Personalization ---
# Your name (LIS will address you by this)
USER_NAME=sir

# Server port
LIS_PORT=8340

# --- Security (recommended) ---
# Set a secret token to require auth on all /api/* endpoints and WebSocket
# When set, requests need: Authorization: Bearer <token>
# When unset, auth is disabled (OK for localhost-only)
# LIS_AUTH_TOKEN=your-secret-token-here

# Allow Claude Code to run with --dangerously-skip-permissions (default: false)
# CLAUDE_SKIP_PERMISSIONS=false

# Comma-separated list of allowed CORS origins (default: localhost:5173,8340)
# LIS_CORS_ORIGINS=http://localhost:5173,http://localhost:8340

# --- Microsoft Graph API ---
# For Calendar, Mail, and Notes on Windows (Device Code Flow)
# Register an app in Azure AD with Mail.Read, Calendars.Read, Notes.Read.All
# MS_GRAPH_CLIENT_ID=your-azure-client-id-here
# MS_GRAPH_TENANT_ID=common
